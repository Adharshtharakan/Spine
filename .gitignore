# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Gradle/Android Studio build output — regenerated on every build, and large
# (Gradle's own HTML reports run to hundreds of KB per report).
/android/app/debug
/android/app/profile
/android/app/release
/android/build/
/android/app/build/
/android/.gradle/

# Android release signing — never commit keystores or their passwords.
android/key.properties
**/*.jks
**/*.keystore

# Transient golden-diff artifacts from a failed preview run.
/test/preview/failures/
