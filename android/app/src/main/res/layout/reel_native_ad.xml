<?xml version="1.0" encoding="utf-8"?>
<!--
  The full-screen reel ad.

  Every clickable element is registered with the SDK in ReelNativeAdFactory,
  so the ids here and the assignments there have to stay in step: an asset
  view that isn't registered renders but records nothing.

  MediaView fills the card and the text sits over its lower third, which is
  the reel convention — the media is the content, not an illustration beside
  it.
-->
<com.google.android.gms.ads.nativead.NativeAdView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0C09">

    <com.google.android.gms.ads.nativead.MediaView
        android:id="@+id/ad_media"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:adjustViewBounds="false"
        android:scaleType="centerCrop" />

    <!-- Scrim so the copy stays readable over any creative. -->
    <View
        android:layout_width="match_parent"
        android:layout_height="320dp"
        android:layout_gravity="bottom"
        android:background="@drawable/reel_ad_scrim" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="120dp">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/ad_icon"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:scaleType="fitCenter"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/ad_advertiser"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:textColor="#B9B2A2"
                android:textSize="12sp"
                android:letterSpacing="0.12"
                android:maxLines="1"
                android:ellipsize="end" />
        </LinearLayout>

        <TextView
            android:id="@+id/ad_headline"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#F4EFE3"
            android:textSize="26sp"
            android:textStyle="bold"
            android:maxLines="3"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/ad_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textColor="#CFC8B8"
            android:textSize="15sp"
            android:maxLines="3"
            android:ellipsize="end" />

        <Button
            android:id="@+id/ad_cta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:background="@drawable/reel_ad_cta"
            android:textColor="#0D0C09"
            android:textSize="14sp"
            android:textStyle="bold"
            android:textAllCaps="true"
            android:paddingStart="26dp"
            android:paddingEnd="26dp"
            android:minHeight="48dp"
            android:stateListAnimator="@null" />
    </LinearLayout>
</com.google.android.gms.ads.nativead.NativeAdView>
